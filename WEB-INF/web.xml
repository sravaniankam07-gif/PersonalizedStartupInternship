<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         version="4.0">

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CompanyLoginServlet</servlet-name>
        <servlet-class>CompanyLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CompanyLoginServlet</servlet-name>
        <url-pattern>/companyLogin</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CompanyDashboardServlet</servlet-name>
        <servlet-class>CompanyDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CompanyDashboardServlet</servlet-name>
        <url-pattern>/companyDashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentDetailsServlet</servlet-name>
        <servlet-class>StudentDetailsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentDetailsServlet</servlet-name>
        <url-pattern>/studentDetails</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StartupRegisterServlet</servlet-name>
        <servlet-class>StartupRegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StartupRegisterServlet</servlet-name>
        <url-pattern>/startupRegister</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PostInternshipServlet</servlet-name>
        <servlet-class>PostInternshipServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PostInternshipServlet</servlet-name>
        <url-pattern>/postInternship</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RecommendationServlet</servlet-name>
        <servlet-class>RecommendationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RecommendationServlet</servlet-name>
        <url-pattern>/recommendations</url-pattern>
    </servlet-mapping>

</web-app>
